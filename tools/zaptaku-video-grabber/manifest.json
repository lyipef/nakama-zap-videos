{
  "manifest_version": 3,
  "name": "Zaptaku Video Grabber",
  "version": "1.0.0",
  "description": "Encontra os vídeos da página e baixa todos de uma vez (somente arquivos de vídeo diretos, sem streams protegidos).",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Zaptaku Video Grabber" },
  "background": { "service_worker": "background.js" },
  "permissions": ["downloads", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["scan.js", "content.js"], "all_frames": true, "run_at": "document_idle" }
  ]
}
